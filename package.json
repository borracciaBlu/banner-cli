{
  "name": "@borracciablu/banner-cli",
  "version": "1.0.34",
  "description": "CLI tool to add a banner comment to your files.",
  "bin": {
    "banner-cli": "index.js"
  },
  "scripts": {
    "lint": "eslint index.js test.js lib/*.js",
    "x--------------------TEST------------------------x": "Code coverage and saucelab",
    "test": "c8 --reporter=html --reporter=text node --test test.js",
    "coveralls": "c8 npm test && c8 report --reporter=lcov"
  },
  "engines": {
    "node": ">= 16"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borracciaBlu/banner-cli.git"
  },
  "files": [
    "banner.js",
    "index.js",
    "lib"
  ],
  "keywords": [
    "automation",
    "banner",
    "cli",
    "comment",
    "comments",
    "contributing",
    "generate",
    "generator",
    "license",
    "package.json",
    "version",
    "versions"
  ],
  "author": "Marco Buttini",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/borracciaBlu/banner-cli/issues"
  },
  "homepage": "https://github.com/borracciaBlu/banner-cli#readme",
  "devDependencies": {
    "c8": "12.0.0",
    "eslint": "9.39.1"
  },
  "dependencies": {
    "commander": "15.0.0",
    "glob": "13.0.6",
    "npmlog": "7.0.1",
    "prepend-file": "2.0.1"
  }
}
